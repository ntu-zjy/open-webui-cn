# Sealos 新加坡部署 — 环境变量清单
# 用法：在 Sealos App Launchpad 创建应用时，把每行 KEY=VALUE 粘到「环境变量」表单。
# 标 [必填] 的必须设置；标 [可选] 的按需开启。

# ---------- 基础 ----------
WEBUI_AUTH=true
WEBUI_SECRET_KEY=                              # [必填] openssl rand -hex 32
WEBUI_NAME=ThinkFlow                           # 站点名（按需改）
DEFAULT_LOCALE=zh-CN                           # 默认中文 UI
ENV=prod
ENABLE_SIGNUP=true
ENABLE_LOGIN_FORM=true
ENABLE_COMMUNITY_SHARING=false
ENABLE_VERSION_UPDATE_CHECK=false

# ---------- 数据库（Sealos Postgres）----------
DATABASE_URL=                                  # [必填] postgresql://user:pwd@host:5432/db
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20

# ---------- Redis（Sealos Redis）----------
REDIS_URL=                                     # [必填] redis://default:pwd@host:6379
WEBSOCKET_REDIS_URL=                           # 同 REDIS_URL
REDIS_KEY_PREFIX=openwebui

# ---------- 对象存储（Sealos Object Storage, S3 兼容）----------
STORAGE_PROVIDER=s3
S3_ACCESS_KEY_ID=                              # [必填]
S3_SECRET_ACCESS_KEY=                          # [必填]
S3_ENDPOINT_URL=https://objectstorageapi.hzh.sealos.run
S3_BUCKET_NAME=openwebui-files                 # [必填]
S3_REGION_NAME=us-east-1                       # Sealos 默认值，填什么都行
S3_KEY_PREFIX=uploads/
S3_ADDRESSING_STYLE=path

# ---------- 大陆访问优化 ----------
GRAVATAR_BASE_URL=https://cravatar.cn/avatar   # Cravatar 中国镜像
# 不要设置 GOOGLE_*、MICROSOFT_* 等 OAuth env（大陆访问不到）

# ---------- 上游模型（在 admin Connections 也可配，但建议这里统一管 key）----------
# OpenAI / Anthropic / Gemini（海外直连，新加坡机房 OK）
OPENAI_API_BASE_URLS=https://api.openai.com/v1
OPENAI_API_KEYS=                               # 分号分隔可多个
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# 国内 OpenAI 兼容端点（推荐通过 admin Connections UI 添加，便于热更）
#   通义:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   豆包:   https://ark.cn-beijing.volces.com/api/v3
#   DeepSeek: https://api.deepseek.com/v1
#   Kimi:   https://api.moonshot.cn/v1

# ---------- 短信（阶段 2 用）----------
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=                      # [必填]
ALIYUN_SMS_ACCESS_KEY_SECRET=                  # [必填]
ALIYUN_SMS_SIGN_NAME=                          # [必填] 阿里云签名，如 "ThinkFlow"
ALIYUN_SMS_TEMPLATE_CODE=                      # [必填] 验证码模板 ID，如 SMS_123456

# ---------- 支付（阶段 4 用）----------
ZPAY_PID=                                      # [必填] Zpay 商户号
ZPAY_KEY=                                      # [必填] Zpay 通信密钥
ZPAY_API_BASE=https://z-pay.cn
ZPAY_NOTIFY_URL=                               # [必填] https://你的域名/api/v1/payments/zpay/notify
ZPAY_RETURN_URL=                               # [必填] https://你的域名/billing/success

# ---------- 配额与计费（阶段 3 用）----------
MODEL_TIER_MAP={"free":["qwen-turbo*","deepseek-chat*"],"plus":["gpt-4o-mini*","claude-haiku*","gemini-flash*","kimi*"],"pro":["gpt-4o*","claude-sonnet*","doubao-pro*","o1-mini*"]}
